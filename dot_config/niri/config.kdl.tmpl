spawn-at-startup "noctalia"

screenshot-path "~/pictures/niri-screenshots/screenshot from %Y-%m-%d %H-%M-%S.png"
prefer-no-csd

environment {
    GTK_THEME "Papirus:dark"
    QT_QPA_PLATFORM "wayland"
    QT_QPA_PLATFORMTHEME "qt6ct"
}

xwayland-satellite {
    path "xwayland-satellite"
}

overview {
    zoom 0.5
    
    workspace-shadow {
        softness 40
        spread 10
        offset x=0 y=10
    }
}

input {
    keyboard {
        xkb {
            
        }

        // numlock
    }

    mouse {
	    accel-profile "flat"
	    accel-speed 0.0
    }

    touchpad {
        accel-profile "flat"
        accel-speed 0.0
        disabled-on-external-mouse
    }
}

cursor {
    xcursor-theme "Vimix-cursors"
    xcursor-size 28
}

{{- if eq .chezmoi.hostname "dwarrowdelf" }}
output "HDMI-A-1" {
    mode "1920x1080@60.000"
    scale 1
    transform "normal"
    position x=0 y=0
}

output "DP-1" {
    mode "3440x1440@143.975"
    scale 1
    transform "normal"
    position x=1920 y=0
}
{{- else if eq .chezmoi.hostname "ainulindale" }}
output "eDP-1" {
    mode "1920x1080@60.010"
    scale 1
    transform "normal"
    position x=0 y=0
}
{{- end}}

layout {
    gaps 9
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
    }

    border {
        off
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
    }

    struts {
        
    }
}

hotkey-overlay {
    skip-at-startup
}

animations {
    slowdown 1
}

window-rule {
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    block-out-from "screen-capture"
}

binds {

    // generics
    Mod+Return                  { spawn "alacritty"; }

    // noctalia shell
    Mod+E                       { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+I                       { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Z                       { spawn-sh "noctalia msg settings-toggle"; }
    Mod+V                       { spawn-sh "noctalia msg panel-toggle clipboard"; }
    Mod+W                       { spawn-sh "noctalia msg panel-toggle wallpaper"; }
    Mod+Shift+Q                 { spawn-sh "noctalia msg panel-toggle session"; }

    // column manip
    Mod+Shift+C                 { center-column; }
    Mod+Shift+M                 { maximize-column; }
    Mod+Shift+H                 { move-column-left; }
    Mod+Shift+L                 { move-column-right; }
    Mod+Shift+J                 { move-column-to-workspace-next; }
    Mod+Shift+K                 { move-column-to-workspace-previous; }
    Mod+Shift+Alt+H             { move-column-to-monitor-left; }
    Mod+Shift+Alt+L             { move-column-to-monitor-right; }
    Mod+Shift+Alt+K             { move-column-to-monitor-up; }
    Mod+Shift+Alt+J             { move-column-to-monitor-down; }
    Mod+H                       { focus-column-left; }
    Mod+L                       { focus-column-right; }
    Mod+Shift+1                 { move-column-to-workspace 1; }
    Mod+Shift+2                 { move-column-to-workspace 2; }
    Mod+Shift+3                 { move-column-to-workspace 3; }
    Mod+Shift+4                 { move-column-to-workspace 4; }
    Mod+Shift+5                 { move-column-to-workspace 5; }
    Mod+Shift+6                 { move-column-to-workspace 6; }
    Mod+Shift+7                 { move-column-to-workspace 7; }
    Mod+Shift+8                 { move-column-to-workspace 8; }
    Mod+Shift+9                 { move-column-to-workspace 9; }

    // window manip
    Mod+Shift+A                 { toggle-window-floating; }
    Mod+Shift+F                 { fullscreen-window; }
    Mod+Q                       { close-window; }
    Mod+K                       { focus-window-up; }
    Mod+J                       { focus-window-down; }
    Mod+bracketleft             { consume-or-expel-column-left; }
    Mod+bracketright            { consume-or-expel-column-right; }
    Mod+A                       { set-column-width 0.333; }
    Mod+S                       { set-column-width 0.5; }
    Mod+D                       { set-column-width 0.667; }
    Mod+F                       { set-column-width 1.0; }
    Mod+R                       { switch-preset-column-width; }
    Mod+T                       { switch-preset-window-height; }

    // workspace manip
    Mod+Ctrl+Alt+H              { move-workspace-to-monitor-left; }
    Mod+Ctrl+Alt+L              { move-workspace-to-monitor-right; }
    Mod+Ctrl+Alt+K              { move-workspace-to-monitor-up; }
    Mod+Ctrl+Alt+J              { move-workspace-to-monitor-down; }
    Mod+Ctrl+J                  { focus-workspace-down; }
    Mod+Ctrl+K                  { focus-workspace-up; }
    Mod+1                       { focus-workspace 1; }
    Mod+2                       { focus-workspace 2; }
    Mod+3                       { focus-workspace 3; }
    Mod+4                       { focus-workspace 4; }
    Mod+5                       { focus-workspace 5; }
    Mod+6                       { focus-workspace 6; }
    Mod+7                       { focus-workspace 7; }
    Mod+8                       { focus-workspace 8; }
    Mod+9                       { focus-workspace 9; }

    // monitor manip
    Mod+Alt+H                   { focus-monitor-next; }
    Mod+Alt+L                   { focus-monitor-previous; }
    Mod+Alt+K                   { focus-monitor-up; }
    Mod+Alt+J                   { focus-monitor-down; }

    // overview manip
    Mod+O                       { toggle-overview; }

    // system manip
    Mod+Shift+Slash             { show-hotkey-overlay; }

    // volume control
    XF86AudioRaiseVolume        allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume        allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute               allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute            allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    // audio control
    XF86AudioPlay               allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop               allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev               allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext               allow-when-locked=true { spawn-sh "playerctl next"; }

    // brightness control
    XF86MonBrightnessUp         allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown       allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    // screenshots
    Print                       { screenshot; }
    Ctrl+Print                  { screenshot-screen; }
    Alt+Print                   { screenshot-window; }

    // lifecycle
    Ctrl+Alt+Delete             { quit; }
}

layer-rule {
    match namespace="^noctalia$"
    place-within-backdrop true
}

layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
}

window-rule {
    background-effect {
        blur true
        xray false
    }
}

layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
    }
}

blur {
    passes 2
    offset 3.0
    noise 0.03
    saturation 1.0
}

debug {
    honor-xdg-activation-with-invalid-serial
}

include "./noctalia.kdl"
