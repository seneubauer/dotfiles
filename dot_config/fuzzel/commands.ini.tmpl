[main]
font                            = {{ .font.menu }}:weight=Regular:size={{ .font.menu_size }}
prompt                          = " "
width                           = 40
lines                           = 10
dpi-aware                       = no
icon-theme                      = Papirus-Dark
show-actions                    = yes
exit-on-keyboard-focus-loss     = no
hide-before-typing              = no
include                         = ~/.config/fuzzel/themes/noctalia

[border]
width                           = 1
radius                          = 6
selection-radius                = 6

[key-bindings]
prev                            = Ctrl+j
next                            = Ctrl+k
