[main]
font                            = {{ .font.menu }}:weight=Regular:size={{ .font.menu_size }}
prompt                          = " "
width                           = 40
lines                           = 10
dpi-aware                       = no
icon-theme                      = Papirus-Dark
show-actions                    = yes
keyboard-focus                  = on-demand
exit-on-keyboard-focus-loss     = yes
hide-before-typing              = no
include                         = ~/.config/fuzzel/themes/noctalia

[border]
width                           = 1
radius                          = 6
selection-radius                = 6

[key-bindings]
delete-line-forward             = none
prev                            = Down Control+j
next                            = Up Control+k
