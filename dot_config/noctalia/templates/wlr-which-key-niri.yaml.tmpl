# theme
font: {{ .wlr_which_key.font }} {{ .wlr_which_key.font_size }}
background: "{{ "{{colors.background.default.hex}}e6" }}"
color: "{{ "{{colors.on_surface.default.hex}}" }}"
border: "{{ "{{colors.primary.default.hex}}" }}"
separator: {{ .wlr_which_key.separator | quote }}
border_width: {{ .wlr_which_key.border_width }}
corner_r: {{ .wlr_which_key.border_radius }}
padding: {{ .wlr_which_key.padding }}
rows_per_column: {{ .wlr_which_key.rows_per_column }}
column_padding: {{ .wlr_which_key.column_padding }}

# position
anchor: {{ .wlr_which_key.anchor }}
margin_right: {{ .wlr_which_key.margin_right }}
margin_bottom: {{ .wlr_which_key.margin_bottom }}
margin_left: {{ .wlr_which_key.margin_left }}
margin_top: {{ .wlr_which_key.margin_top }}

# behavior
inhibit_compositor_keyboard_shortcuts: {{ .wlr_which_key.inhibit_comp }}
auto_kbd_layout: {{ .wlr_which_key.auto_kdb_layout }}

menu:
  - key: "l"
    desc: Layout
    submenu:
      - key: "w"
        desc: Window
        submenu:
          - key: "l"
            desc: Floating
            cmd: niri msg action toggle-window-floating
          - key: "f"
            desc: Fullscreen
            cmd: niri msg action fullscreen-window
          - key: "BackSpace"
            desc: Go Back
            cmd: wlr-which-key -k "l" ~/.config/wlr-which-key/config-niri.yaml
      - key: "BackSpace"
        desc: Go Back
        cmd: wlr-which-key ~/.config/wlr-which-key/config-niri.yaml
  - key: "r"
    desc: Resize
    submenu:
      - key: "h"
        desc: Height
        submenu:
          - key: "a"
            desc: 33.3%
            cmd: niri msg action set-window-height "33.%"
          - key: "s"
            desc: 50.0%
            cmd: niri msg action set-window-height "50.0%"
          - key: "d"
            desc: 66.7%
            cmd: niri msg action set-window-height "66.7%"
          - key: "f"
            desc: 100.0%
            cmd: niri msg action set-window-height "100.0%"
          - key: "BackSpace"
            desc: Go Back
            cmd: wlr-which-key -k "r" ~/.config/wlr-which-key/config-niri.yaml
      - key: "w"
        desc: Width
        submenu:
          - key: "a"
            desc: 33.3%
            cmd: niri msg action set-window-width "33.3%"
          - key: "s"
            desc: 50.0%
            cmd: niri msg action set-window-width "50.0%"
          - key: "d"
            desc: 66.7%
            cmd: niri msg action set-window-width "66.7%"
          - key: "f"
            desc: 100.0%
            cmd: niri msg action set-window-width "100.0%"
          - key: "BackSpace"
            desc: Go Back
            cmd: wlr-which-key -k "r" ~/.config/wlr-which-key/config-niri.yaml
      - key: "BackSpace"
        desc: Go Back
        cmd: wlr-which-key ~/.config/wlr-which-key/config-niri.yaml
  - key: "m"
    desc: Move to Monitor
    submenu:
      - key: "c"
        desc: Column
        submenu:
          - key: "h"
            desc: Left
            cmd: niri msg action move-column-to-monitor-left
          - key: "l"
            desc: Right
            cmd: niri msg action move-column-to-monitor-right
          - key: "k"
            desc: Up
            cmd: niri msg action move-column-to-monitor-up
          - key: "j"
            desc: Down
            cmd: niri msg action move-column-to-monitor-down
          - key: "BackSpace"
            desc: Go Back
            cmd: wlr-which-key -k "m" ~/.config/wlr-which-key/config-niri.yaml
      - key: "s"
        desc: Workspace
        submenu:
          - key: "h"
            desc: Left
            cmd: niri msg action move-workspace-to-monitor-left
          - key: "l"
            desc: Right
            cmd: niri msg action move-workspace-to-monitor-right
          - key: "k"
            desc: Up
            cmd: niri msg action move-workspace-to-monitor-up
          - key: "j"
            desc: Down
            cmd: niri msg action move-workspace-to-monitor-down
          - key: "BackSpace"
            desc: Go Back
            cmd: wlr-which-key -k "m" ~/.config/wlr-which-key/config-niri.yaml
      - key: "BackSpace"
        desc: Go Back
        cmd: wlr-which-key ~/.config/wlr-which-key/config-niri.yaml
