# theme
font: {{ .wlr_which_key.font }} {{ .wlr_which_key.font_size }}
background: "{{ "{{colors.background.default.hex}}e6" }}"
color: "{{ "{{colors.on_surface.default.hex}}" }}"
border: "{{ "{{colors.primary.default.hex}}" }}"
separator: {{ .wlr_which_key.separator | quote }}
border_width: {{ .wlr_which_key.border_width }}
corner_r: {{ .wlr_which_key.border_radius }}
padding: {{ .wlr_which_key.padding }}
rows_per_column: {{ .wlr_which_key.rows_per_column }}
column_padding: {{ .wlr_which_key.column_padding }}

# position
anchor: {{ .wlr_which_key.anchor }}
margin_right: {{ .wlr_which_key.margin_right }}
margin_bottom: {{ .wlr_which_key.margin_bottom }}
margin_left: {{ .wlr_which_key.margin_left }}
margin_top: {{ .wlr_which_key.margin_top }}

# behavior
inhibit_compositor_keyboard_shortcuts: {{ .wlr_which_key.inhibit_comp }}
auto_kbd_layout: {{ .wlr_which_key.auto_kdb_layout }}

menu:
  - key: "t"
    desc: Theme
    submenu:
      - key: "l"
        desc: Light
        cmd: noctalia msg theme-mode-set light
      - key: "d"
        desc: Dark
        cmd: noctalia msg theme-mode-set dark
      - key: "u"
        desc: Update Templates
        cmd: noctalia msg templates-apply
      - key: "BackSpace"
        desc: Go Back
        cmd: wlr-which-key ~/.config/wlr-which-key/config-noctalia.yaml
  - key: "m"
    desc: Media
    submenu:
      - key: "j"
        desc: Next
        cmd: noctalia msg media next
      - key: "k"
        desc: Previous
        cmd: noctalia msg media previous
      - key: "p"
        desc: Play/Pause
        cmd: noctalia msg media toggle
      - key: "s"
        desc: Stop
        cmd: noctalia msg media stop
      - key: "BackSpace"
        desc: Go Back
        cmd: wlr-which-key ~/.config/wlr-which-key/config-noctalia.yaml
  - key: "d"
    desc: Desktop
    submenu:
      - key: "t"
        desc: Toggle
        cmd: noctalia msg desktop-widgets-toggle
      - key: "e"
        desc: Edit
        cmd: noctalia msg desktop-widgets-toggle-edit
      - key: "BackSpace"
        desc: Go Back
        cmd: wlr-which-key ~/.config/wlr-which-key/config-noctalia.yaml
  - key: "n"
    desc: Notes
    submenu:
      - key: "r"
        desc: Retrieve
        cmd: ~/.config/wlr-which-key/notes-retrieve.sh
      - key: "p"
        desc: Publish
        cmd: ~/.config/wlr-which-key/notes-publish.sh
      - key: "BackSpace"
        desc: Go Back
        cmd: wlr-which-key ~/.config/wlr-which-key/config-noctalia.yaml
  - key: "s"
    desc: Screenshot
    submenu:
      - key: "r"
        desc: Region
        cmd: noctalia msg screenshot-region
      - key: "f"
        desc: Fullscreen
        cmd: noctalia msg screenshot-fullscreen
      - key: "a"
        desc: Annotate
        cmd: noctalia msg screenshot-annotate
      - key: "BackSpace"
        desc: Go Back
        cmd: wlr-which-key ~/.config/wlr-which-key/config-noctalia.yaml
