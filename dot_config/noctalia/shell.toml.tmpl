[shell]
avatar_path = {{ .images.avatar | quote }}
corner_radius_scale = 0.25
screen_time_enabled = true
polkit_agent = true
niri_overview_type_to_launch_enabled = true
{{- if eq .chezmoi.hostname "dwarrowdelf" }}
font_family = "Comfortaa"
{{- else if eq .chezmoi.hostname "ainulindale" }}
font_family = "Nunito"
{{- end }}

[shell.animation]
speed = 2

[shell.panel]
transparency_mode = "soft"
control_center_placement = "floating"
control_center_position = "center"
launcher_placement = "floating"
launcher_position = "center"
wallpaper_placement = "floating"
wallpaper_position = "center"
session_placement = "floating"
session_position = "center"

[shell.launcher]
sort_by_usage = false
categories = false

[shell.screenshot]
directory = "~/pictures/noctalia-screenshots"

[[shell.session.actions]]
action = "lock"
enabled = true
shortcut = "1"
variant = "default"

[[shell.session.actions]]
action = "logout"
enabled = true
shortcut = "2"
variant = "default"

[[shell.session.actions]]
action = "lock_and_suspend"
enabled = false
shortcut = "5"
variant = "default"

[[shell.session.actions]]
action = "reboot"
enabled = true
shortcut = "3"
variant = "default"

[[shell.session.actions]]
action = "shutdown"
enabled = true
shortcut = "4"
variant = "destructive"
