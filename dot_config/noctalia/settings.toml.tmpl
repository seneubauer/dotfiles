[location]
address = {{ .city | quote }}

[brightness]
enable_ddcutil = true

[weather]
unit = "imperial"

[nightlight]
enabled = true
temperature_night = 4000

[backdrop]
enabled = true

[control_center.calendar]
show_event_cards = false

[[control_center.shortcuts]]
type = "nightlight"

[[control_center.shortcuts]]
type = "notification"

[[control_center.shortcuts]]
type = "power_profile"

[[control_center.shortcuts]]
type = "screen_time"
