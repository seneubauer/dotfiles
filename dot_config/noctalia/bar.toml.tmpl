{{- $desktop := env "XDG_CURRENT_DESKTOP" -}}

[bar]
order                   = [ "top", "side" ]

[bar.top]
concave_edge_corners    = true
margin_edge             = 0
margin_ends             = 0
radius                  = 0
radius_bottom_left      = 6
radius_bottom_right     = 6
radius_top_left         = 0
radius_top_right        = 0
capsule                 = false
widget_spacing          = 9
padding                 = 9
position                = "top"
start                   = [ "control-center", "workspaces" ]
center                  = [ "weather", "audio_visualizer", "media" ]
{{- if eq .chezmoi.hostname "dwarrowdelf" }}
end                     = [ "taskbar", "tray", "keybinds", "shell_menu", "panel_menu", "volume", "notifications", "network", "clock", "date" ]
{{- else if eq .chezmoi.hostname "ainulindale" }}
end                     = [ "taskbar", "tray", "keybinds", "shell_menu", "panel_menu", "battery", "volume", "notifications", "network", "clock", "date" ]
{{- end }}

[bar.top.actions]
middle                  = "none"

[widget.control-center]
glyph                   = "navigation"

[widget.workspaces]
style                   = "minimal"
max_label_chars         = 3
anchor                  = true

[widget.weather]
show_condition          = false
show_temperature        = false

[widget.audio_visualizer]
anchor                  = true
show_when_idle          = true
width                   = 256
bands                   = 128
capsule                 = true
mirrored                = false

[widget.media]
title_scroll            = "on_hover"

[widget.taskbar]
show_all_outputs        = true

[widget.tray]
drawer                  = true

[widget.keybinds]
type                    = "custom_button"
glyph                   = "keyboard"

[widget.keybinds.actions]
{{- if eq $desktop "umbriel" }}
left                    = "exec umbriel msg cheatsheet-toggle"
{{- else if eq $desktop "niri" }}
left                    = "exec niri msg action show-hotkey-overlay"
{{- end }}

[widget.shell_menu]
type                    = "custom_button"
glyph                   = "notes"

[widget.shell_menu.actions]
left                    = "none"

[widget.panel_menu]
type                    = "custom_button"
glyph                   = "notes"

[widget.panel_menu.actions]
left                    = "none"

[widget.battery]
show_label              = false

[widget.volume]
show_label              = false

[widget.notifications]
hide_when_no_unread     = true

[widget.network]
show_label              = false

[widget.clock]
format                  = "{:%H:%M}"
tooltip_format          = ""

[widget.date]
format                  = "{:%Y-%m-%d}"
tooltip_format          = "{:%A, %B %d}"
