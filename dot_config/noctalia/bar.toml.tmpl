[bar]
order = [ "top", "side" ]

[bar.top]
concave_edge_corners = true
margin_edge = 0
margin_ends = 0
radius = 0
radius_bottom_left = 6
radius_bottom_right = 6
radius_top_left = 0
radius_top_right = 0
capsule = false
capsule_padding = 9.0
widget_spacing = 12
position = "top"
start = [ "workspaces", "taskbar", "tray" ]
center = [ "control-center", "audio_visualizer", "session" ]
{{- if eq .chezmoi.hostname "dwarrowdelf" }}
end = [ "volume", "brightness", "notifications", "clipboard", "network", "date" ]
{{- else if eq .chezmoi.hostname "ainulindale" }}
end = [ "battery", "volume", "brightness", "notifications", "clipboard", "network", "date" ]
{{- end }}

[bar.top.actions]
middle = "none"

[bar.side]
concave_edge_corners = true
margin_edge = 0
radius = 0
auto_hide = true
show_on_workspace_switch = true
reserve_space = false
widget_spacing = 12

{{- if eq .chezmoi.hostname "dwarrowdelf" }}

[bar.side.monitor.DP-1]
position = "right"
margin_ends = 300
radius_bottom_left = 6
radius_bottom_right = 0
radius_top_left = 6
radius_top_right = 0

[bar.side.monitor.HDMI-A-1]
position = "left"
margin_ends = 300
radius_bottom_left = 0
radius_bottom_right = 6
radius_top_left = 0
radius_top_right = 6

{{- else if eq .chezmoi.hostname "ainulindale" }}

position = "right"
margin_ends = 300
radius_bottom_left = 6
radius_bottom_right = 0
radius_top_left = 6
radius_top_right = 0

{{- end }}

capsule = false
start = [ "update_templates", "toggle_widget_edit", "toggle_widget_visibility" ]
center = [ "launcher", "wallpaper", "gamermode", "keybinds", "open_notes" ]
end = [ "settings" ]

[widget.workspaces]
style = "minimal"

[widget.control-center]
glyph = "navigation"

[widget.audio_visualizer]
anchor = true
show_when_idle = true
width = 256
bands = 64
capsule = true

[widget.battery]
show_label = false

[widget.volume]
show_label = false

[widget.brightness]
show_label = false

[widget.network]
show_label = false

[widget.clock]
format = "{:%H:%M}"

[widget.date]
format = "{:%Y-%m-%d %H:%M}"
tooltip_format = "{:%Y-%m-%d}"

[widget.update_templates]
type = "custom_button"
glyph = "file-settings"

[widget.update_templates.actions]
left = "exec noctalia msg templates-apply"

[widget.toggle_widget_edit]
type = "custom_button"
glyph = "device-desktop-cog"

[widget.toggle_widget_edit.actions]
left = "exec noctalia msg desktop-widgets-toggle-edit"

[widget.toggle_widget_visibility]
type = "custom_button"
glyph = "device-desktop"

[widget.keybinds]
type = "kenn/keybind-cheatsheet:keybinds"

[widget.gamermode]
type = "nomadcxx/gamer-mode:gamermode"
