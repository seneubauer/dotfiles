[bar]
order = [ "top", "bottom" ]

[bar.top]
concave_edge_corners = true
margin_edge = 0
margin_ends = 0
radius = 0
radius_bottom_left = 6
radius_bottom_right = 6
radius_top_left = 0
radius_top_right = 0
capsule = true
capsule_padding = 9.0
widget_spacing = 9
position = "top"
start = [ "group:g1" ]
center = [ "group:g2", "audio_visualizer", "media" ]
end = [ "group:g3", "group:g4" ]

[bar.top.actions]
middle = "none"

[[bar.top.capsule_group]]
id = "g1"
accordion = false
accordion_direction = "end"
enabled = true
fill = "surface_variant"
members = [ "control-center", "gamermode", "wallpaper", "keybinds", "status" ]
opacity = 1.0
padding = 6.0
widget_spacing = 9

[[bar.top.capsule_group]]
id = "g2"
accordion = true
accordion_direction = "start"
enabled = true
fill = "surface_variant"
members = [ "launcher", "update_templates", "toggle_widget_edit" ]
opacity = 1.0
padding = 6.0
widget_spacing = 9

[[bar.top.capsule_group]]
id = "g3"
accordion = false
accordion_direction = "end"
fill = "surface_variant"
members = [ "volume", "brightness", "notifications", "clipboard", "network" ]
opacity = 1.0
padding = 6.0
widget_spacing = 9

[[bar.top.capsule_group]]
id = "g4"
accordion = false
accordion_direction = "end"
fill = "surface_variant"
members = [ "date", "clock" ]
opacity = 1.0
padding = 6.0
widget_spacing = 9

[bar.bottom]
concave_edge_corners = true
margin_edge = 0
margin_ends = 0
radius = 0
radius_bottom_left = 0
radius_bottom_right = 0
radius_top_left = 6
radius_top_right = 6
capsule = true
capsule_padding = 9.0
widget_spacing = 9
position = "bottom"
start = [ "taskbar", "tray" ]
center = [ "workspaces" ]
end = [ "group:g1" ]

[[bar.bottom.capsule_group]]
id = "g1"
accordion = false
accordion_direction = "start"
fill = "surface_variant"
{{- if eq .chezmoi.hostname "ainulindale" }}
members = [ "cpu_usage", "cpu_temp", "gpu_usage", "gpu_temp", "gpu_vram", "ram", "swap", "battery" ]
{{- else if eq .chezmoi.hostname "dwarrowdelf" }}
members = [ "cpu_usage", "cpu_temp", "gpu_usage", "gpu_temp", "gpu_vram", "ram", "swap" ]
{{- end }}
opacity = 1.0
padding = 6.0
widget_spacing = 9

[widget.audio_visualizer]
anchor = true
show_when_idle = true
width = 256
bands = 64

[widget.media]
album_art_only = true
hide_artist = true
hide_when_no_media = false

[widget.gamermode]
type = "nomadcxx/gamer-mode:gamermode"

[widget.keybinds]
type = "kenn/keybind-cheatsheet:keybinds"

[widget.status]
type = "davemhammer/obsidian:status"

[widget.update_templates]
type = "custom_button"
glyph = "toml"

[widget.update_templates.actions]
left = "exec noctalia msg templates-apply"

[widget.toggle_widget_edit]
type = "custom_button"
glyph = "device-desktop-cog"

[widget.toggle_widget_edit.actions]
left = "exec noctalia msg desktop-widgets-toggle-edit"

[widget.volume]
show_label = false

[widget.brightness]
show_label = false

[widget.network]
show_label = false

[widget.date]
format = "{:%B %e, %A}"
tooltip_format = "{:%Y-%m-%d}"

[widget.clock]
format = "{:%H:%M}"

[widget.cpu_usage]
type = "sysmon"
visualization = "none"
stat = "cpu_usage"
font_family = {{ .font.widget_mono | quote }}

[widget.cpu_temp]
type = "sysmon"
visualization = "none"
stat = "cpu_temp"
font_family = {{ .font.widget_mono | quote }}

[widget.gpu_usage]
type = "sysmon"
visualization = "none"
stat = "gpu_usage"
font_family = {{ .font.widget_mono | quote }}

[widget.gpu_temp]
type = "sysmon"
visualization = "none"
stat = "gpu_temp"
font_family = {{ .font.widget_mono | quote }}

[widget.gpu_vram]
type = "sysmon"
visualization = "none"
stat = "gpu_vram"
font_family = {{ .font.widget_mono | quote }}

[widget.ram]
type = "sysmon"
visualization = "none"
stat = "ram_pct"
font_family = {{ .font.widget_mono | quote }}

[widget.swap]
type = "sysmon"
visualization = "none"
stat = "swap_pct"
font_family = {{ .font.widget_mono | quote }}

[widget.battery]
show_label = true
font_family = {{ .font.widget_mono | quote }}
