[wallpaper]
transition = [ "honeycomb" ]
transition_on_startup = true
transition_duration = 1000

{{- if eq .chezmoi.hostname "dwarrowdelf" }}

per_monitor_directories = true

[wallpaper.monitor.DP-1]
directory_dark = {{ .directory.wallpaper.dark.wp3440 | quote }}
directory_light = {{ .directory.wallpaper.light.wp3440 | quote }}

[wallpaper.monitor.HDMI-A-1]
directory_dark = {{ .directory.wallpaper.dark.wp1920 | quote }}
directory_light = {{ .directory.wallpaper.light.wp1920 | quote }}

{{- else if eq .chezmoi.hostname "ainulindale" }}

per_monitor_directories = false
directory_dark = {{ .directory.wallpaper.dark.wp1920 | quote }}
directory_light = {{ .directory.wallpaper.light.wp1920 | quote }}

{{- end}}

[wallpaper.automation]
enabled = false
interval_seconds = 1800
